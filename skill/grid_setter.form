FILE_TYPE=FORM_DEFN VERSION=2
FORM
FIXED
PORT 72 13
HEADER "Grid Setter"

TILE

TEXT "mil:"
TLOC 2 2
ENDTEXT

FIELD rb_m5
FLOC 8 2
CHECKLIST "5" "mil_radio"
ENDFIELD

FIELD rb_m10
FLOC 16 2
CHECKLIST "10" "mil_radio"
ENDFIELD

FIELD rb_m12
FLOC 25 2
CHECKLIST "12.5" "mil_radio"
ENDFIELD

FIELD rb_m25
FLOC 35 2
CHECKLIST "25" "mil_radio"
ENDFIELD

FIELD rb_m50
FLOC 45 2
CHECKLIST "50" "mil_radio"
ENDFIELD

FIELD rb_m100
FLOC 55 2
CHECKLIST "100" "mil_radio"
ENDFIELD

FIELD rb_m200
FLOC 63 2
CHECKLIST "200" "mil_radio"
ENDFIELD

FIELD rb_m400
FLOC 71 2
CHECKLIST "400" "mil_radio"
ENDFIELD

TEXT "mm:"
TLOC 2 4
ENDTEXT

FIELD rb_mm_01
FLOC 8 4
CHECKLIST "0.1" "mm_radio"
ENDFIELD

FIELD rb_mm_02
FLOC 18 4
CHECKLIST "0.2" "mm_radio"
ENDFIELD

FIELD rb_mm_025
FLOC 28 4
CHECKLIST "0.25" "mm_radio"
ENDFIELD

FIELD rb_mm_05
FLOC 40 4
CHECKLIST "0.5" "mm_radio"
ENDFIELD

FIELD rb_mm_1
FLOC 52 4
CHECKLIST "1" "mm_radio"
ENDFIELD

FIELD rb_mm_2
FLOC 62 4
CHECKLIST "2" "mm_radio"
ENDFIELD

TEXT "Custom (mil):"
TLOC 2 6
ENDTEXT

FIELD custom_size
FLOC 17 6
STRFILLIN 12 20
ENDFIELD

FIELD close
FLOC 58 8
MENUBUTTON "Close" 8 2
ENDFIELD

ENDTILE

ENDFORM
